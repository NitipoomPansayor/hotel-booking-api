{
  "info": {
    "name": "Hotel Booking API",
    "description": "Run the folders in order. Register/Login save {{token}}; \"Login as Admin\" saves {{adminToken}} (promote that account to role \"admin\" in MongoDB first). Create Hotel saves {{hotelId}}, Create Booking saves {{bookingId}}. Booking dates are computed relative to today by the collection pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const day = (n) => new Date(Date.now() + n * 864e5).toISOString().slice(0, 10);",
          "pm.variables.set('checkIn', day(7));",
          "pm.variables.set('checkOut', day(9));",
          "pm.variables.set('checkOutTooLong', day(11));",
          "pm.variables.set('pastDate', day(-1));",
          "pm.variables.set('newCheckIn', day(14));",
          "pm.variables.set('newCheckOut', day(17));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
