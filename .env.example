# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
# Max requests per client per 10 minutes (default 100). One full Postman run is ~95 requests,
# so raise it locally (e.g. 1000) to run the collection repeatedly. Keep the default in production.
RATE_LIMIT_MAX=100
EXCHANGE_RATE_API_KEY=

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-booking

# JWT signing secret: use a long random string
JWT_SECRET=change-me
JWT_EXPIRE=30d
# Token cookie lifetime in days
JWT_COOKIE_EXPIRE=30

# Used by `npm run seed:admin` to create or promote the admin account
ADMIN_NAME=Site Admin
ADMIN_TEL=0800000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Login password for the sample users created by `npm run seed` (min 6 characters)
SEED_USER_PASSWORD=change-me
