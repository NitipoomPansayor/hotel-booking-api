# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-booking

# JWT signing secret: use a long random string
JWT_SECRET=change-me
JWT_EXPIRE=30d
# Token cookie lifetime in days
JWT_COOKIE_EXPIRE=30

# Used by `npm run seed:admin` to create or promote the admin account
ADMIN_NAME=Site Admin
ADMIN_TEL=0800000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
